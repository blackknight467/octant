{
  "name": "octant",
  "description": "Octant is an extensible platform that provides modules that help developers better understand their Kuberenetes resources.",
  "author": "The Octant Team",
  "version": "0.25.1",
  "homepage": "https://octant.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vmware-tanzu/octant.git"
  },
  "bugs": {
    "url": "https://github.com/vmware-tanzu/octant/issues"
  },
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node ./node_modules/@angular/cli/bin/ng build --configuration production --output-hashing=all",
    "build-electron": "npx tsc -p tsconfig.serve.json && npm run build -- --base-href ./",
    "test": "ng test --watch=false --browsers=ElectronDebug",
    "test:headless": "ng test --watch=false --browsers=ChromeHeadless --source-map=false",
    "lint": "prettier -c 'src/**/*.ts'",
    "clean": "rimraf ./dist/octant/*",
    "prettier": "prettier --write \"src/{app,environments,assets}/**/*{.ts,.js,.json,.css,.scss}\"",
    "electron:serve": "wait-on http-get://localhost:7777 && npm run electron:serve-tsc && electron . --serve",
    "electron:serve-tsc": "npx tsc -p tsconfig.serve.json",
    "electron:local": "npx tsc -p tsconfig.serve.json && npx ng build --base-href ./ && npx electron --local .",
    "electron:build": "npm run build-electron && npx electron-builder -p never",
    "postinstall": "rimraf ./node_modules/cytoscape-node-html-label/dist/cytoscape-node-html-label.d.ts"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "arrowParens": "avoid",
    "singleQuote": true
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.1",
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/elements": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-browser-dynamic": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@cds/angular": "^6.17.0",
    "@cds/city": "^1.1.0",
    "@cds/core": "^6.17.0",
    "@clr/angular": "^18.2.1",
    "@clr/ui": "^18.2.1",
    "@materia-ui/ngx-monaco-editor": "^6.0.0",
    "@ng-select/ng-select": "^23.5.1",
    "@webcomponents/custom-elements": "^1.5.0",
    "angular-resizable-element": "^5.0.0",
    "ansi_up": "^5.0.0",
    "core-js": "^3.16.1",
    "cytoscape": "^3.18.1",
    "cytoscape-dagre": "^2.3.0",
    "cytoscape-node-html-label": "^1.2.2",
    "d3-graphviz": "^2.6.1",
    "d3-zoom": "^2.0.0",
    "dagre-d3": "^0.6.4",
    "electron-store": "^5.2.0",
    "get-port": "^5.1.1",
    "highlight.js": "^10.2.1",
    "jsoneditor": "^9.4.1",
    "karma-electron-launcher": "^0.3.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "monaco-editor": "^0.21.2",
    "ngx-highlightjs": "^6.1.3",
    "open": "^8.0.7",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-ngx": "^0.5.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.0.3",
    "ws": "^7.4.6",
    "xterm": "^4.9.0",
    "xterm-addon-fit": "^0.4.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@angular/language-service": "^22.1.1",
    "@types/d3": "~5.16.3",
    "@types/jasmine": "^3.9.1",
    "@types/lodash": "^4.17.25",
    "@types/node": "^20.19.9",
    "@types/ws": "^7.4.4",
    "dayjs": "^1.9.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "jasmine-core": "~3.9.0",
    "karma": "^6.3.2",
    "karma-chrome-launcher": "^3.1.0",
    "karma-coverage": "^2.0.3",
    "karma-electron": "^7.3.0",
    "karma-jasmine": "^4.0.1",
    "karma-jasmine-html-reporter": "^1.5.4",
    "karma-spec-reporter": "0.0.32",
    "marked": "^2.0.1",
    "prettier": "^2.3.2",
    "rimraf": "^3.0.2",
    "ts-mockito": "^2.6.1",
    "ts-protoc-gen": "^0.13.0",
    "typescript": "~6.0.0",
    "wait-on": "^5.2.0"
  }
}
