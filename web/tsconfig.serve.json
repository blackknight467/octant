{
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    // This config does not extend tsconfig.base.json, so it does not inherit its
    // "strict": false. TypeScript 6 flipped the default to true, which this
    // (unmodernised) Electron main-process code does not satisfy.
    "strict": false,
    // The main process is CommonJS: it uses `import x = require(...)`, and node16
    // resolution would hand back namespace objects for `open` and `ws`, making
    // them non-callable. node10 is deprecated in TS 6 but still correct here.
    "ignoreDeprecations": "6.0",
    "module": "commonjs",
    "moduleResolution": "node10",
    "experimentalDecorators": true,
    "target": "es2022",
    "types": [
      "node"
    ],
    "lib": [
      "es2022",
      "dom"
    ]
  },
  "include": [
    "main.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}
